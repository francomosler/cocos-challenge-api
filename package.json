{
  "name": "cocos-challenge-api",
  "version": "1.0.0",
  "description": "API de portfolio, búsqueda de activos y órdenes para el challenge de backend de Cocos",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "reconcile": "node --env-file-if-exists=.env scripts/reconcile.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node --env-file-if-exists=.env --test --test-timeout=120000 \"test/**/*.test.ts\"",
    "test:unit": "node --test --test-timeout=120000 \"test/unit/**/*.test.ts\"",
    "test:functional": "node --env-file-if-exists=.env --test --test-timeout=120000 \"test/functional/**/*.test.ts\"",
    "demo:concurrency": "node scripts/demo-concurrency.ts"
  },
  "dependencies": {
    "@fastify/swagger": "^9.9.5",
    "@fastify/swagger-ui": "^6.1.4",
    "@fastify/type-provider-typebox": "^6.3.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "typebox": "^1.4.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2"
  }
}
