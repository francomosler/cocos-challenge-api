# Copiar a .env para desarrollo local (docker compose up -d db).
DATABASE_URL=postgres://cocos:cocos@localhost:5433/cocos
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Tope de conexiones a Postgres por instancia de la API.
DB_POOL_MAX=10
# Cuánto espera un request por una conexión libre antes de responder 503.
DB_CONNECT_TIMEOUT_MS=5000
# Cuánto espera una transacción por un lock de fila antes de responder 503.
DB_LOCK_TIMEOUT_MS=3000
# Corte de cualquier sentencia que se cuelgue.
DB_STATEMENT_TIMEOUT_MS=5000

# Pedidos que una instancia atiende a la vez. El siguiente recibe 503 en el momento.
# Para dimensionarlo: capacidad por segundo × espera aceptable (2.500 órdenes/s × 0,2 s = 500).
MAX_IN_FLIGHT_REQUESTS=500
# Pedidos de una misma cuenta que trabajan contra la base a la vez; el resto espera su turno.
# Muy por debajo de DB_POOL_MAX: una cuenta puede ocupar hasta el doble de este valor en conexiones.
ACCOUNT_MAX_CONCURRENT=2
# Pedidos de una misma cuenta que pueden esperar turno. El siguiente recibe 429.
# Cuántos pedidos simultáneos de una misma cuenta se consideran uso legítimo.
ACCOUNT_MAX_QUEUED=20
# Cuánto espera un pedido su turno antes de responder 503.
# Menor que el timeout de quien llama a la API: no sirve darle el turno a un pedido que ya nadie espera.
ACCOUNT_MAX_WAIT_MS=2000
